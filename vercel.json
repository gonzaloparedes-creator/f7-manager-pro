{
  "rewrites": [
    {
      "source": "/tracking/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|Slackbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|Applebot|redditbot|vkShare).*"
        }
      ],
      "destination": "/api/tracking-og?code=:code"
    },
    {
      "source": "/tracking/:code",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-mode"
        }
      ],
      "destination": "/api/tracking-og?code=:code"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
